<header class="doc-head im-wrap-wide">
	{{#if page.eyebrow}}<p class="im-eyebrow">{{page.eyebrow}}</p>{{/if}}
	<h1>{{page.title}}</h1>
	{{#if page.description}}<p class="im-lede">{{page.description}}</p>{{/if}}
	{{#if page.source}}<p class="doc-source"><code>{{page.source}}</code></p>{{/if}}
</header>
{{{doc_body}}}

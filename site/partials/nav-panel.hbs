{{!-- The docs menu for a window too narrow for the side nav: the same
	sections as the sidebar, as an accordion. One column, every section a
	<details> that opens to its pages; the section holding the current page
	starts open. Ninety links in two flowing columns was a 4,000px scroll. --}}
<div class="im-navpanel-list">
	{{#each nav}}
	<details class="im-navtree im-navtree-panel"{{#if open}} open{{/if}}>
		<summary>{{#if icon}}{{icon icon}}{{/if}}<span>{{#if title}}{{title}}{{else}}Start{{/if}}</span><small>{{items.length}}</small></summary>
		<div class="im-navtree-items">
			{{#each items}}
			{{#if children}}
			<p class="im-navcol-subtitle">{{label}}</p>
			{{#each children}}<a class="im-navlink" href="{{url}}"{{#if current}} aria-current="page"{{/if}}><span>{{label}}</span></a>{{/each}}
			{{else}}
			<a class="im-navlink" href="{{url}}"{{#if current}} aria-current="page"{{/if}}><span>{{label}}</span></a>
			{{/if}}
			{{/each}}
		</div>
	</details>
	{{/each}}
</div>

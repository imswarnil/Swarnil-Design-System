---
title: Live · be right back
layout: home
shell: frame
---
<div class="im-studio im-studio-wait im-studio-dark" style="--im-studio-w: 1920; --im-studio-h: 1080">
	<span class="im-studio-ground im-studio-ground-rings" aria-hidden="true"></span>
	<span class="im-studio-backdrop im-studio-backdrop-vignette" aria-hidden="true"></span>
	<div class="im-studio-stream-head">
		<p class="im-studio-mark" style="position: static">{{> "components/logo" mark=true text="Swarnil" class="im-logo-canvas"}}<span>imswarnil</span></p>
		<span class="im-studio-spacer"></span>
		<p class="im-studio-tally im-studio-tally-static im-studio-glass" data-state="live"><i></i>Live</p>
		<span class="im-studio-chip">2,412 watching</span>
	</div>
	<div class="im-studio-card im-studio-glass">
		<div class="im-studio-copy">
			<p class="im-studio-card-eyebrow"><i></i>Two minutes</p>
			<h1 class="im-studio-title">Be right <em>back</em></h1>
			<p class="im-studio-sub">Chat stays open. Ask the question now; I will answer it when I am back.</p>
		</div>
		<p class="im-studio-countdown im-studio-countdown-mono"><span>01</span><i>:</i><span>58</span></p>
	</div>
	<span class="im-studio-note im-studio-note-lg im-studio-at" style="--im-studio-x: 68%; --im-studio-y: 30%; --im-studio-tilt: 8deg">coffee</span>
	<p class="im-studio-handles"><span>{{> "icons/brand-youtube"}}@imswarnil</span><span>{{> "icons/globe"}}imswarnil.com/live</span></p>
</div>

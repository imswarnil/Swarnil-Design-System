---
title: Scene · outro
layout: home
shell: frame
---
<div class="im-studio im-studio-scene im-studio-scene-outro" style="--im-studio-w: 1920; --im-studio-h: 1080">
	<span class="im-studio-ground im-studio-ground-rings" aria-hidden="true"></span>
	<div class="im-studio-scene-head"><p class="im-studio-mark">{{> "components/logo" mark=true text="Swarnil"}}<span>imswarnil</span></p></div>
	<div class="im-studio-scene-stage">
		<div class="im-studio-titleblock im-studio-stagger">
			<p class="im-studio-kicker im-studio-layer" data-in="rise">That is the film</p>
			<h1 class="im-studio-title im-studio-layer" data-in="line-up">Watch the <em>next</em> one</h1>
			<p class="im-studio-sub im-studio-layer" data-in="rise">Or the one before it. They are a set.</p>
			<div class="im-studio-end-sub im-studio-end-sub-accent im-studio-layer" data-in="pop"><img class="im-studio-face" src="{{demo.me}}" alt="" style="object-position: 62% 30%"><b>Subscribe</b></div>
		</div>
		<div class="im-studio-end-slots im-studio-stagger">
			<div class="im-studio-end-slot im-studio-layer" data-in="scale"><img src="{{demo.shots.[1]}}" alt=""><span>Next</span></div>
			<div class="im-studio-end-slot im-studio-layer" data-in="scale"><img src="{{demo.shots.[5]}}" alt=""><span>Before</span></div>
		</div>
	</div>
	<div class="im-studio-scene-foot"><span>imswarnil.com</span><span class="im-studio-spacer"></span><span>youtube.com/@imswarnil</span></div>
</div>

---
title: Channel art
layout: home
shell: frame
---
{{!-- Channel art: 2560 × 1440. The page grid edge to edge; a cover across the
	band every device keeps (2560 × 423, from 508px down); the phone's safe
	1546 in its middle. data-safe draws the band. See src/studio/youtube.css. --}}
<div class="im-studio im-studio-banner im-studio-cream" style="--im-studio-w: 2560; --im-studio-h: 1440" data-safe>
	<span class="im-studio-bg im-bg-grid" aria-hidden="true"></span>
	<span class="im-studio-safe" data-size="1546 × 423" aria-hidden="true"></span>
	<div class="im-studio-banner-cover">
		<img class="im-studio-banner-art" src="{{demo.art}}" alt="">

		<div class="im-studio-banner-trail" aria-hidden="true">
			<svg viewBox="0 0 480 79.3" preserveAspectRatio="none">
				<path class="im-studio-trail-dash" d="M222 68 C232 60 240 54 246 43"/>
				<path class="im-studio-trail-dash" d="M246 40 C250 28 248 18 242 11"/>
				<circle class="im-studio-trail-dot" cx="242" cy="9.5" r="3"/>
			</svg>
		</div>
		<span class="im-studio-pill im-studio-pill-accent im-studio-at" style="--im-studio-x: 50.4%; --im-studio-y: 6%">Budapest</span>
		<span class="im-studio-badge im-studio-at" style="--im-studio-x: 51.3%; --im-studio-y: 53%">{{> "icons/navigation"}}</span>
		<span class="im-studio-pill im-studio-at" style="--im-studio-x: 44%; --im-studio-y: 90%">India</span>
		<span class="im-studio-note im-studio-at" style="--im-studio-x: 46.5%; --im-studio-y: 70%; --im-studio-tilt: -8deg; font-size: 0.75em">journey</span>

		<div class="im-studio-banner-follow">
			<span class="im-studio-label">Follow along</span>
			<span class="im-studio-socials">
				<span class="im-studio-social">{{> "icons/brand-youtube"}}</span>
				<span class="im-studio-social">{{> "icons/brand-instagram"}}</span>
				<span class="im-studio-social">{{> "icons/brand-x"}}</span>
				<span class="im-studio-social">{{> "icons/brand-github"}}</span>
			</span>
		</div>
		<span class="im-studio-note im-studio-at" style="--im-studio-x: 12.9%; --im-studio-y: 30%; --im-studio-tilt: -6deg; font-size: 0.75em">say hi!</span>

		<div class="im-studio-banner-intro">
			<p class="im-studio-greeting">जय जिनेन्द्र</p>
			<h1 class="im-studio-title">I am <span class="im-logo" role="img" aria-label="Swarnil"><b class="im-logo-type" aria-hidden="true">Swarnil</b><i class="im-logo-dot" aria-hidden="true"></i></span></h1>
			<p class="im-studio-facts">
				<span class="im-studio-fact">{{> "icons/briefcase"}}Salesforce Engineer</span>
				<span class="im-studio-fact">{{> "icons/map-pin"}}Budapest, Hungary</span>
			</p>
			<p class="im-studio-note">Documenting my life.</p>
			<p class="im-studio-facts">
				<span class="im-studio-fact im-studio-fact-accent">{{> "icons/globe"}}imswarnil.com</span>
				<span class="im-studio-fact im-studio-fact-accent">{{> "icons/mail"}}contact@imswarnil.com</span>
			</p>
		</div>

		<div class="im-studio-tilelabel im-studio-at" style="--im-studio-x: 59.8%; --im-studio-y: 22%; --im-studio-tilt: -6deg"><span class="im-studio-tile im-studio-tile-accent">{{> "icons/zap"}}</span><span class="im-studio-note im-studio-note-ink">build</span></div>
		<div class="im-studio-tilelabel im-studio-at" style="--im-studio-x: 58.1%; --im-studio-y: 56%; --im-studio-tilt: 5deg"><span class="im-studio-tile im-studio-tile-accent">{{> "icons/sparkles"}}</span><span class="im-studio-note">ai</span></div>
		<div class="im-studio-tilelabel im-studio-at" style="--im-studio-x: 60.8%; --im-studio-y: 86%; --im-studio-tilt: -5deg"><span class="im-studio-tile">{{> "icons/code"}}</span></div>
		<div class="im-studio-tilelabel im-studio-at" style="--im-studio-x: 78.3%; --im-studio-y: 20%; --im-studio-tilt: 6deg"><span class="im-studio-tile im-dotted-corner">{{> "icons/video"}}</span><span class="im-studio-note im-studio-note-ink">vlogs</span></div>
		<div class="im-studio-tilelabel im-studio-at" style="--im-studio-x: 78.5%; --im-studio-y: 54%; --im-studio-tilt: -4deg"><span class="im-studio-tile">{{> "icons/compass"}}</span><span class="im-studio-note im-studio-note-ink">travel</span></div>
		<div class="im-studio-tilelabel im-studio-at" style="--im-studio-x: 79%; --im-studio-y: 85%; --im-studio-tilt: 5deg"><span class="im-studio-tile">{{> "icons/flame"}}</span><span class="im-studio-note">party!</span></div>

		<div class="im-studio-banner-schedule">
			<span class="im-studio-label">Schedule</span>
			<p class="im-studio-slot"><span class="im-dot im-dot-live"></span><b>Live stream</b><small>Every Sunday · 9:00</small></p>
			<hr>
			<p class="im-studio-slot">{{> "icons/play"}}<b>New video</b><small>Every Friday · 6:00</small></p>
		</div>
		<span class="im-studio-note im-studio-at" style="--im-studio-x: 94.6%; --im-studio-y: 22%; --im-studio-tilt: 7deg; font-size: 0.75em">tune in!</span>
	</div>
</div>

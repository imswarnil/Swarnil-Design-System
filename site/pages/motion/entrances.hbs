	<div class="tile" data-replay-tile><p class="im-caption" data-index="12">iris</p><figure class="im-fx-img im-ratio-4-3"><img data-im-in="iris" src="{{demo.three.[0].feature_image}}" alt="" loading="lazy"></figure><span class="text-sm">Opens from the centre, like a lens.</span></div>
	<div class="tile" data-replay-tile><p class="im-caption" data-index="13">blinds</p><figure class="im-fx-img im-ratio-4-3"><img data-im-in="blinds" src="{{demo.three.[0].feature_image}}" alt="" loading="lazy"></figure><span class="text-sm">Eight slats open together.</span></div>
	<div class="tile" data-replay-tile><p class="im-caption" data-index="14">zoom-out</p><figure class="im-fx-img im-ratio-4-3"><img data-im-in="zoom-out" src="{{demo.three.[0].feature_image}}" alt="" loading="lazy"></figure><span class="text-sm">Settles back from slightly too close.</span></div>

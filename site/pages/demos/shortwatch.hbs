---
title: Short watch demo
layout: home
shell: frame
---
{{!-- Loaded in an iframe by /collections/video/short/. Clip on the left at
	its real proportion, everything else on the right, one viewport. --}}
{{#with demo.videos.[0]}}
<div class="im-shortwatch">
	<div class="im-shortwatch-stage">
		<div class="im-shortwatch-step">
			<button class="im-btn im-btn-icon" type="button" aria-label="Previous">{{> "icons/chevron-up"}}</button>
			<button class="im-btn im-btn-icon" type="button" aria-label="Next">{{> "icons/chevron-down"}}</button>
		</div>
		<div class="im-shortwatch-player">
			<img src="{{thumb}}" alt="">
			<span class="im-short-bar"><span style="width: 38%"></span></span>
		</div>
	</div>

	<div class="im-shortwatch-panel">
		<p class="im-snipcard-meta"><span class="im-kind" data-kind="short">{{> "icons/video"}}Reel</span><span>{{views}} views</span><span>{{when}}</span><span>{{time}}</span></p>
		<h1 class="im-shortwatch-title">{{title}}</h1>

		<div class="im-vidhead-by">
			{{> "components/avatar" src=avatar name=channel}}
			<div><strong>{{channel}}</strong><small>128k subscribers</small></div>
			<button class="im-btn im-btn-primary im-btn-sm" type="button" style="margin-left: auto">Subscribe</button>
		</div>

		<p style="color: var(--im-body); font-size: var(--im-text-sm); line-height: 1.6">Forty kilometres that take two hours. The whole road, cut down to the bits where the bus folds its mirrors in. Full version on the channel.</p>

		<dl class="im-widget-facts"><dt>Shot</dt><dd>Amalfi, Nov 2025</dd><dt>Camera</dt><dd><a href="/collections/uses/page/">X100VI</a></dd><dt>Full film</dt><dd><a href="/collections/video/page/">8:12 on the channel</a></dd><dt>Trip</dt><dd><a href="/collections/travel/trip/">The itinerary</a></dd></dl>
		<p class="im-cluster" style="--im-cluster-gap: .375rem"><span class="im-topic">#amalfi</span><span class="im-topic">#travel</span></p>

		{{> "components/comments" thread=../demo.comments count="318" lean=true limit="1"}}
	</div>
</div>
{{/with}}

		<span class="im-poster-time">14:00</span>
	</figure>
	<figure class="im-poster im-poster-icon">
		<span class="im-poster-chip">lesson 02</span>
		<span class="im-poster-glyph">{{icon "git-commit-vertical"}}</span>
		<strong class="im-poster-word">branches without fear</strong>
		<span class="im-poster-ep">02/12</span>
		<span class="im-poster-time">17:20</span>
	</figure>
	<figure class="im-poster im-poster-screen">
		<strong class="im-poster-word">edit 2× faster<i class="im-poster-dot"></i></strong>
		<div class="im-poster-screen-frame"><img src="/assets/photos/desk-minimal.jpg" alt=""></div>
		<span class="im-poster-chip">how to</span>
		<img class="im-poster-subject im-poster-card" src="/assets/photos/camera-street.jpg" alt="">

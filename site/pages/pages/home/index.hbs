---
title: Homepage
layout: home
description: A personal home — who, in one line; then the latest of everything, each in its own collection's card.
eyebrow: Pages
source: src/components/pages.css
---
<section class="im-section im-wrap im-pt-sm im-section-sm">
	<p class="im-eyebrow">Pages · {{page.title}}</p>
	<p class="im-lede">{{page.description}}</p>
	<p class="doc-source"><code>{{page.source}}</code></p>
</section>

<div class="im-wrap-wide im-stack" style="--im-stack-gap: clamp(3rem, 2rem + 3vw, 5rem)">
	<header class="im-homehero">
		<div class="im-stack im-stack-sm">
			<p class="im-eyebrow">{{demo.author.name}} · Amsterdam</p>
			<h1 class="im-homehero-title">I build things for the web and <em>write down</em> what they cost.</h1>
			<p class="im-lede im-m0">Salesforce consulting, a design system I sell, and a letter every fortnight.</p>
			<p class="im-cluster im-cluster-tight">
				<a class="im-btn im-btn-primary" href="/collections/post/">{{icon "pencil"}}Read the latest</a>
				<a class="im-btn" href="/pages/about/">About</a>
				<a class="im-btn" href="/pages/contact/">{{icon "mail"}}Hire me</a>
			</p>
			<div class="im-widget-stats im-border-0 im-p-0">
				<div><strong data-im-count>34</strong><span>Posts this year</span></div>
				<div><strong data-im-count>4,210</strong><span>Readers</span></div>
				<div><strong data-im-count>128k</strong><span>Subscribers</span></div>
			</div>
		</div>
		<div class="im-homehero-side">
			{{#with demo.post}}{{> "components/post-card" layout="row" excerpt=true kind="post"}}{{/with}}
			{{#with demo.projects.[0]}}{{> "components/repo-card"}}{{/with}}
		</div>
	</header>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="writing">Writing</p><a class="im-card-cta" href="/collections/post/">All posts {{> "icons/arrow-right"}}</a></div>
		<div class="im-feed im-feed-md">{{#each demo.mixed}}{{#match @index "<" 3}}{{> "components/post-card" excerpt=true kind="post"}}{{/match}}{{/each}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="video">Latest film</p><a class="im-card-cta" href="/collections/video/">The channel {{> "icons/arrow-right"}}</a></div>
		<div class="im-vidgrid">{{#each demo.videos}}{{#match @index "<" 4}}{{> "components/video-card" hide_by=true kind="video"}}{{/match}}{{/each}}</div>
	</section>

	<aside class="im-ad im-ad-leaderboard im-mx-auto" aria-label="Advertisement"><span class="im-ad-label">Sponsored</span><span class="im-ad-slot"><img src="{{demo.shots.[4]}}" alt="" loading="lazy"></span></aside>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="now">Lately</p><a class="im-card-cta" href="/collections/timeline/">The timeline {{> "icons/arrow-right"}}</a></div>
		<ol class="im-stream">{{#each demo.stream.[0].items}}<li class="im-stream-item" data-kind="{{kind}}"><span class="im-stream-mark">{{icon mark}}</span><div class="im-stream-body"><p class="im-stream-meta"><span class="im-stream-kind">{{label}}</span><time>{{when}}</time></p><h3 class="im-stream-title"><a href="{{#if url}}{{url}}{{else}}/collections/timeline/{{/if}}">{{title}}</a></h3></div></li>{{/each}}</ol>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="work">Work</p><a class="im-card-cta" href="/collections/project/">All projects {{> "icons/arrow-right"}}</a></div>
		<div class="im-repos">{{#each demo.projects}}{{#match @index "<" 3}}{{> "components/repo-card" cta=true kind="project"}}{{/match}}{{/each}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="travel">Travel</p><a class="im-card-cta" href="/collections/travel/">All trips {{> "icons/arrow-right"}}</a></div>
		<div class="im-trips">{{#each demo.trips}}{{#match @index "<" 3}}<a class="im-tripcard" href="/collections/travel/trip/"><img src="{{lookup @root.demo.shots @index}}" alt="" loading="lazy"><span class="im-kind im-kind-over" data-kind="tag">{{icon "map-pin"}}{{country}}</span><span class="im-exp-figure">{{days}}<small>days</small></span><span class="im-tripcard-body"><span class="im-tripcard-title">{{title}}</span><span class="im-tripcard-meta"><span>{{when}}</span><span>{{km}} km</span></span><span class="im-tripcard-more"><span>{{text}}</span></span></span></a>{{/match}}{{/each}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="shop">In the shop</p><a class="im-card-cta" href="/collections/shop/">Everything {{> "icons/arrow-right"}}</a></div>
		<div class="im-products">{{#each demo.shop}}{{#match @index "<" 3}}<article class="im-product"><span class="im-product-media"><img src="{{lookup @root.demo.shots @index}}" alt="" loading="lazy"></span><p><span class="im-kind">{{icon "package"}}{{kind}}</span></p><h3><a class="im-product-name" href="/collections/shop/product/">{{name}}</a></h3><p class="im-product-text">{{text}}</p><p class="im-product-foot"><span class="im-price">{{cost}}</span><a class="im-btn im-btn-sm im-btn-primary" href="/collections/shop/product/">Buy {{icon "arrow-right"}}</a></p></article>{{/match}}{{/each}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="series">Series</p><a class="im-card-cta" href="/collections/series/">All series {{> "icons/arrow-right"}}</a></div>
		<div class="im-seriescards">{{#each demo.seriesall}}{{#match @index "<" 2}}<article class="im-seriescard" data-state="{{#match state "=" "Running"}}running{{else}}finished{{/match}}"><span class="im-seriescard-media"><img src="{{lookup @root.demo.shots @index}}" alt="" loading="lazy"></span><p><span class="im-kind" data-kind="series">{{icon "square-play"}}Series</span></p><a class="im-seriescard-name" href="/collections/series/">{{name}}</a><p class="im-seriescard-meta"><span class="im-seriescard-state">{{state}}</span><span>{{parts}} parts</span></p><p class="im-seriescard-text">{{text}}</p></article>{{/match}}{{/each}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="courses">Courses</p><a class="im-card-cta" href="/collections/course/">All courses {{> "icons/arrow-right"}}</a></div>
		<div class="im-coursecards">{{#each demo.courses}}<article class="im-coursecard {{pattern}}"><div class="im-coursecard-art" aria-hidden="true">{{{diagram}}}</div><div class="im-coursecard-body"><p class="im-coursecard-meta"><span class="im-kind" data-kind="course">{{icon "graduation-cap"}}{{level}}</span><span>{{lessons}} lessons</span></p><h3 class="im-coursecard-title"><a href="/collections/course/page/">{{name}}</a></h3><p class="im-coursecard-foot"><span class="im-rating" style="--im-rating: {{rating}}"><span class="im-rating-stars" aria-hidden="true"></span></span><b>{{cost}}</b></p></div></article>{{/each}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="code">Snippets & prompts</p><a class="im-card-cta" href="/collections/snippets/">All snippets {{> "icons/arrow-right"}}</a></div>
		<div class="im-grid-auto im-grid-lg">{{#each demo.snippets}}{{#match @index "<" 2}}{{> "components/snippet-card"}}{{/match}}{{/each}}{{#with demo.prompts.[0]}}{{> "components/prompt-card"}}{{/with}}</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="things">Things I use · things I did</p><a class="im-card-cta" href="/collections/uses/">Uses {{> "icons/arrow-right"}}</a></div>
		<div class="im-grid-auto im-grid-lg">
			{{#each demo.uses}}{{#match @index "<" 2}}<article class="im-affiliate im-affiliate-compact"><span class="im-affiliate-media im-thumb"><img src="{{lookup @root.demo.shots @index}}" alt="" loading="lazy"></span><a class="im-affiliate-name" href="/collections/uses/page/">{{name}}</a><p class="im-affiliate-by">{{by}}</p><p class="im-affiliate-meta"><span class="im-affiliate-price">{{cost}}</span></p><a class="im-affiliate-go" href="/collections/uses/page/" aria-label="Open">{{icon "arrow-up-right"}}</a></article>{{/match}}{{/each}}
			{{#each demo.experience}}{{#match @index "<" 2}}<article class="im-exp"><span class="im-exp-media"><img src="{{lookup @root.demo.shots shot}}" alt="" loading="lazy"><span class="im-exp-figure">{{figure}}<small>{{unit}}</small></span><span class="im-kind im-kind-over" data-kind="experience">{{icon "compass"}}{{kind}}</span></span><div class="im-exp-body"><p class="im-exp-where"><span>{{where}}</span><span>{{when}}</span></p><h3 class="im-exp-title"><a href="/collections/experience/page/">{{title}}</a></h3></div></article>{{/match}}{{/each}}
		</div>
	</section>

	<section class="im-section im-section-tight">
		<div class="home-head"><p class="im-caption" data-index="letters">The letter</p><a class="im-card-cta" href="/collections/newsletter/">Every letter {{> "icons/arrow-right"}}</a></div>
		<div class="im-letters">{{#each demo.issues}}{{#match @index "<" 3}}<article class="im-letter">{{#if shot}}<span class="im-letter-media"><img src="{{lookup @root.demo.shots shot}}" alt="" loading="lazy"><span class="im-letter-n">#{{n}}</span></span>{{else}}<span class="im-letter-media im-center-grid" ><span class="im-issue-tile im-static" ><b>{{n}}</b><strong>{{day}}</strong><span>{{month}}</span><small>{{year}}</small></span></span>{{/if}}<div class="im-letter-body"><p class="im-letter-date">{{sent}}</p><h3 class="im-letter-title"><a href="/collections/newsletter/issue/">{{title}}</a></h3></div></article>{{/match}}{{/each}}</div>
	</section>

	<section class="im-mediabg im-mediabg-lg" data-blend="multiply" style="--im-mediabg-tint: #1d4ed8">
		<img src="{{demo.shots.[3]}}" alt="">
		<div class="im-mediabg-scrim"></div>
		<div class="im-mediabg-copy">
			<h2 class="im-mediabg-title">The letter</h2>
			<p class="im-mediabg-text">One thing I built, one thing I got wrong, three links. Every fortnight.</p>
			<div class="im-max-sm im-mt-sm">{{> "components/subscribe" id="home-email" button="Join"}}</div>
		</div>
	</section>
</div>

<section class="im-section im-wrap"><div class="im-prose">
<p>Every block is a collection's own card: the featured post uses <code>im-featured</code>, the film row is the video card, the "lately" list is the <a href="/collections/timeline/">stream</a>, the letter sits on a <a href="/media/backgrounds/">media background</a>. Nothing here exists only for the home page.</p>
</div></section>

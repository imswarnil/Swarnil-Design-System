---
title: Project log
layout: home
description: What shipped, in order — a stepper of dated entries with the version, what changed, and a shot of it. The project's history as a page of its own, not a section at the bottom of one.
eyebrow: Collections · Project
source: src/components/repo-card.css · timeline.css
---
<section class="im-section im-wrap" style="padding-top: 1.5rem; --im-section-gap: 1.5rem">
	<p class="im-eyebrow">Collections · Project · {{page.title}}</p>
	<p class="im-lede">{{page.description}}</p>
	<p class="doc-source"><code>{{page.source}}</code></p>
</section>

<div class="im-single im-wrap" data-sidebar="on">
	<article class="im-stack" style="--im-stack-gap: 2rem">
		<header class="im-stack" style="--im-stack-gap: .75rem">
			<nav aria-label="Breadcrumb">
				<ol class="im-breadcrumb im-breadcrumb-chevron">
					<li><a href="/">{{> "icons/house"}}<span>Home</span></a></li>
					<li><a href="/collections/project/">{{> "icons/folder"}}<span>Projects</span></a></li>
					<li><a href="/collections/project/page/">im-design-system</a></li>
					<li><span aria-current="page">Log</span></li>
				</ol>
			</nav>
			<p><span class="im-kind" data-kind="project">{{icon "git-commit-vertical"}}Log</span></p>
			<h1 class="im-collhead-title">What shipped, and when</h1>
			<p class="im-collhead-text">Every version of <a href="/collections/project/page/">im-design-system</a> since the first one, in order, with what changed and why. It is the honest version of a changelog — the ones that got reverted are here too.</p>
			<p class="im-collhead-meta"><span>{{demo.log.length}} entries</span><span>v0.1 — v0.7</span><a href="#log">RSS</a></p>
		</header>

		<ol class="im-legs" id="log">
			{{#each demo.log}}
			<li class="im-leg"{{#if state}} data-state="{{state}}"{{/if}}>
				<span class="im-leg-day"><b>{{day}}</b>Day</span>
				<p class="im-leg-route"><span>{{when}}</span><span>{{tag}}</span></p>
				<h2 class="im-leg-title">{{title}}</h2>
				<p class="im-leg-text">{{text}}</p>
				{{#if shot}}<figure class="im-log-shot"><img src="{{lookup ../demo.shots shot}}" alt="" loading="lazy"><figcaption>{{title}}</figcaption></figure>{{/if}}
				{{#if cost}}<p class="im-leg-facts"><span>{{icon "clock"}}<b>{{cost}}</b> of work</span><span>{{icon "git-commit-vertical"}}<b>{{tag}}</b></span></p>{{/if}}
			</li>
			{{/each}}
		</ol>

		<div class="im-loadmore">
			<button class="im-btn" type="button">Earlier versions</button>
			<p>4 of 11</p>
		</div>
	</article>

	<aside>
		<div class="im-sticky-rail">
			<div class="im-widgets">
				<section class="im-widget" aria-labelledby="l-proj">
					<h2 class="im-widget-title" id="l-proj">The project</h2>
					<div class="im-widget-products">
						<a class="im-widget-product" href="/collections/project/page/"><span class="im-widget-product-mark">{{icon "folder"}}</span><span class="im-widget-product-name">im-design-system</span><span class="im-widget-product-note">The case study</span>{{icon "arrow-up-right"}}</a>
						<a class="im-widget-product" href="#log"><span class="im-widget-product-mark">{{icon "brand-github"}}</span><span class="im-widget-product-name">Source</span><span class="im-widget-product-note">1.2k stars · MIT</span>{{icon "arrow-up-right"}}</a>
					</div>
				</section>

				<section class="im-widget" aria-labelledby="l-vers">
					<h2 class="im-widget-title" id="l-vers">Versions</h2>
					<ol class="im-timeline im-timeline-compact im-widget-series">
						{{#each demo.log}}
						<li class="im-timeline-item" data-state="{{state}}">
							<span class="im-timeline-marker">{{day}}</span>
							<h3 class="im-timeline-title">{{#match state "=" "current"}}<span>{{title}}</span>{{else}}<a href="#log">{{title}}</a>{{/match}}</h3>
						</li>
						{{/each}}
					</ol>
				</section>

				<section class="im-widget" aria-labelledby="l-notes">
					<h2 class="im-widget-title" id="l-notes">Working notes <a href="/collections/timeline/">All</a></h2>
					<ul class="im-widget-list">
						{{#each demo.stream.[0].items}}{{#match @index "<" 3}}<li><a href="/collections/timeline/">{{title}}<small>{{when}}</small></a></li>{{/match}}{{/each}}
					</ul>
				</section>

				<section class="im-widget im-widget-fill" aria-labelledby="l-sub">
					<h2 class="im-widget-title" id="l-sub">Releases</h2>
					<p class="im-widget-heading">One email when a version ships.</p>
					{{> "components/subscribe" id="log-email" button="Join"}}
				</section>
			</div>
		</div>
	</aside>
</div>

<section class="im-section im-wrap"><div class="im-prose">
<p>A log is progress, so it counts in <strong>days</strong>, not dates: the same <code>im-legs</code> a <a href="/collections/travel/trip/">trip</a> uses, with the version where the route goes and the hours where the cost goes. The current step is marked; the next is dashed. The rail lists the versions and links each to its step.</p>
</div></section>

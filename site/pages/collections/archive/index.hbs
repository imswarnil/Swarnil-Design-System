---
title: Archive
layout: home
description: Everything on the site, every kind, by year — one row each, with the kind on the row so the list can be scanned.
eyebrow: Collections
source: src/components/collection.css
---
<section class="im-section im-wrap" style="padding-top: 1.5rem; --im-section-gap: 1.5rem">
	<p class="im-eyebrow">Collections · {{page.title}}</p>
	<p class="im-lede">{{page.description}}</p>
	<p class="doc-source"><code>{{page.source}}</code></p>
</section>

<div class="im-single im-wrap-wide" data-sidebar="on">
	<article class="im-stack" style="--im-stack-gap: 1.75rem">
		<header class="im-collhead im-collhead-patterned">
			<span class="im-collhead-art im-bg-rules" style="--im-art: var(--im-c-timeline)" aria-hidden="true"></span>
			<p class="im-eyebrow">Archive</p>
			<h1 class="im-collhead-title">Everything, by year</h1>
			<p class="im-collhead-text">Posts, films, releases, letters, trips, snippets — one row each. For finding the thing you half remember.</p>
			<p class="im-collhead-meta"><span>92 things</span><span>Since 2023</span></p>
		</header>

		<div class="im-collbar">
			<div class="im-collbar-filters" role="group" aria-label="Which kind" data-im-filter="#archive">
				<button class="im-tag" type="button" value="all" aria-current="page">All</button>
				<button class="im-tag" type="button" value="post" aria-current="false">{{icon "pencil"}}Posts</button>
				<button class="im-tag" type="button" value="video" aria-current="false">{{icon "video"}}Films</button>
				<button class="im-tag" type="button" value="project" aria-current="false">{{icon "folder"}}Projects</button>
				<button class="im-tag" type="button" value="issue" aria-current="false">{{icon "mail"}}Letters</button>
				<button class="im-tag" type="button" value="trip" aria-current="false">{{icon "map-pin"}}Trips</button>
				<button class="im-tag" type="button" value="snippet" aria-current="false">{{icon "code"}}Snippets</button>
			</div>
			<div class="im-btn-group im-viewswitch" role="group" aria-label="How to draw the list" data-im-view="#archive">
				<button class="im-btn im-btn-sm" type="button" value="list" aria-pressed="true">{{icon "rows-3"}}List</button>
				<button class="im-btn im-btn-sm" type="button" value="plain" aria-pressed="false">{{icon "list"}}Plain</button>
			</div>
		</div>

		<div class="im-archive" id="archive" data-view="list">
			<div class="im-archive-year">
				<p class="im-archive-head"><strong>2026</strong><span>this year</span></p>
				{{#each demo.mixed}}<a class="im-archive-row" href="/collections/post/article/" data-facet="post"><time class="im-archive-date">{{date published_at format="D MMM"}}</time><span class="im-archive-title">{{title}}</span><span class="im-kind" data-kind="post">{{icon "file-text"}}Post</span></a>{{/each}}
				{{#each demo.videos}}{{#match @index "<" 3}}<a class="im-archive-row" href="/collections/video/page/" data-facet="video"><time class="im-archive-date">{{when}}</time><span class="im-archive-title">{{title}}</span><span class="im-kind" data-kind="video">{{icon "video"}}Film</span></a>{{/match}}{{/each}}
				{{#each demo.projects}}{{#match @index "<" 2}}<a class="im-archive-row" href="/collections/project/page/" data-facet="project"><time class="im-archive-date">{{since}}</time><span class="im-archive-title">{{name}}</span><span class="im-kind" data-kind="project">{{icon "folder"}}Project</span></a>{{/match}}{{/each}}
				{{#each demo.issues}}<a class="im-archive-row" href="/collections/newsletter/issue/" data-facet="issue"><time class="im-archive-date">{{day}} {{month}}</time><span class="im-archive-title">{{title}}</span><span class="im-kind" data-kind="issue">{{icon "mail"}}Letter</span></a>{{/each}}
				{{#each demo.snippets}}{{#match @index "<" 3}}<a class="im-archive-row" href="/collections/snippets/page/" data-facet="snippet"><time class="im-archive-date">Sep</time><span class="im-archive-title">{{name}}</span><span class="im-kind" data-kind="snippet">{{icon "code"}}Snippet</span></a>{{/match}}{{/each}}
			</div>
			<div class="im-archive-year">
				<p class="im-archive-head"><strong>2025</strong><span>4 things</span></p>
				{{#each demo.trips}}{{#match @index "<" 2}}<a class="im-archive-row" href="/collections/travel/trip/" data-facet="trip"><time class="im-archive-date">{{when}}</time><span class="im-archive-title">{{title}}</span><span class="im-kind" data-kind="trip">{{icon "map-pin"}}Trip</span></a>{{/match}}{{/each}}
				{{#each demo.videos}}{{#match @index ">" 5}}<a class="im-archive-row" href="/collections/video/page/" data-facet="video"><time class="im-archive-date">{{when}}</time><span class="im-archive-title">{{title}}</span><span class="im-kind" data-kind="video">{{icon "video"}}Film</span></a>{{/match}}{{/each}}
			</div>
			<p class="im-feed-empty" data-facet-empty hidden>Nothing of that kind.</p>
		</div>
	</article>

	<aside>
		<div class="im-sticky-rail">
			<div class="im-widgets">
				<section class="im-widget" aria-labelledby="ar-year">
					<h2 class="im-widget-title" id="ar-year">By year</h2>
					<nav class="im-widget-archive">{{#each demo.archive}}<a href="#archive">{{year}}<small>{{posts}}</small></a>{{/each}}</nav>
				</section>
				<section class="im-widget" aria-labelledby="ar-kind">
					<h2 class="im-widget-title" id="ar-kind">By kind</h2>
					<ul class="im-widget-list">
						<li><a href="/collections/post/">Posts<small>34</small></a></li><li><a href="/collections/video/">Films<small>12</small></a></li><li><a href="/collections/project/">Projects<small>6</small></a></li><li><a href="/collections/newsletter/">Letters<small>42</small></a></li><li><a href="/collections/travel/">Trips<small>4</small></a></li><li><a href="/collections/snippets/">Snippets<small>6</small></a></li>
					</ul>
				</section>
				<section class="im-widget" aria-labelledby="ar-tags">
					<h2 class="im-widget-title" id="ar-tags">Topics <a href="/collections/tag/">All</a></h2>
					<div class="im-cluster" style="--im-cluster-gap: .375rem">{{#each demo.topics}}<a class="im-tag" href="/collections/tag/page/">{{icon mark}}{{name}}</a>{{/each}}</div>
				</section>
			</div>
		</div>
	</aside>
</div>

<section class="im-section im-wrap"><div class="im-prose">
<p>One list for every collection: <code>im-archive</code> rows grouped by year, each with its <a href="/collections/post/card/">kind chip</a>, filtered by kind and drawn as a list or plain titles. In a theme it is one <code>{{"{{#get \"posts\" limit=\"all\"}}"}}</code> grouped in the template, with the kind read from the primary tag.</p>
</div></section>

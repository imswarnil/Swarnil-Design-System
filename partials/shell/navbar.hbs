{{!-- Site navbar — for a site without a side nav.
	  ≥ lg   brand · primary links · a mega menu · "More" ……… search · theme · star · CTA
	  < lg   menu button · brand ……… search · CTA        (links move to the menu panel)

	Params
	  id          unique per page, default "nav" — prefixes the panel and menu ids
	  line        true = a hairline under it
	  island      true = a floating pill, centred, with the page either side
	  float       true = a full bar that BECOMES that pill once the page scrolls
	  mega        name of a partial rendering .im-navcols — adds a mega menu
	  mega_label  its top-bar link, default "Explore"
	  github      repo URL — shows a Star button
	  stars       "owner/repo" — fills the star count in from GitHub's public API
	  cta_label, cta_url   the button; defaults to Ghost's signup portal --}}
<header class="im-topbar im-topbar-site{{#if line}} im-topbar-line{{/if}}{{#if island}} im-topbar-island{{/if}}{{#if float}} im-topbar-float{{/if}}"{{#if float}} data-im-stick="8"{{/if}}>
	<div class="im-topbar-start">
		<button class="im-btn im-btn-ghost im-btn-icon lg:hidden" type="button" data-drawer-open="#{{#if id}}{{id}}{{else}}nav{{/if}}-panel" aria-label="{{t "Open navigation"}}">{{> "icons/menu"}}</button>
		{{!-- An island bar has no room for a name: it gets the SQUARE, which is
		      the same lockup with one letter. --}}
		<a class="im-brand{{#if island}} im-brand-mark{{/if}}" href="{{@site.url}}">
			{{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}"><span>{{@site.title}}</span>{{else}}{{> "components/logo" mark=island}}{{/if}}
		</a>
		<nav class="im-topbar-nav" aria-label="{{t "Primary"}}">
			{{navigation}}
			{{#if mega}}
				<button class="im-toplink" type="button" popovertarget="{{#if id}}{{id}}{{else}}nav{{/if}}-mega" aria-expanded="false">{{#if mega_label}}{{mega_label}}{{else}}{{t "Explore"}}{{/if}}{{> "icons/chevron-down"}}</button>
			{{/if}}
			{{#if @site.secondary_navigation}}
				<button class="im-toplink" type="button" popovertarget="{{#if id}}{{id}}{{else}}nav{{/if}}-more" aria-expanded="false">{{t "More"}}{{> "icons/chevron-down"}}</button>
				<div class="im-menu" id="{{#if id}}{{id}}{{else}}nav{{/if}}-more" popover data-align="start">{{navigation type="secondary" as="menu"}}</div>
			{{/if}}
		</nav>
	</div>

	<div class="im-topbar-end">
		<button class="im-btn im-btn-ghost im-btn-icon" type="button" data-ghost-search aria-label="{{t "Search"}}">{{> "icons/search"}}</button>
		{{> "components/theme-button"}}
		{{#if github}}
			<a class="im-star im-star-sm max-md:hidden" href="{{github}}" target="_blank" rel="noopener noreferrer"{{#if stars}} data-im-stars="{{stars}}"{{/if}}>{{> "icons/brand-github"}}<span>{{t "Star"}}</span><b data-im-star-count>{{#if star_count}}{{star_count}}{{/if}}</b></a>
			<a class="im-btn im-btn-ghost im-btn-icon md:hidden" href="{{github}}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">{{> "icons/brand-github"}}</a>
		{{/if}}
		{{#unless @member}}
			<a class="im-btn im-btn-primary im-btn-sm" href="{{#if cta_url}}{{cta_url}}{{else}}#/portal/signup{{/if}}">{{#if cta_label}}{{cta_label}}{{else}}{{t "Subscribe"}}{{/if}}</a>
		{{/unless}}
	</div>
</header>

{{#if mega}}
<div class="im-mega" id="{{#if id}}{{id}}{{else}}nav{{/if}}-mega" popover data-align="center">
	{{> (lookup . "mega")}}
</div>
{{/if}}

{{!-- The menu panel. Centred, and wider on a laptop than on a phone — the same
	sheet, grown. The links are plain rows in columns, not tiles: a site with
	thirty destinations needs a list, and this is the same markup the mega menu
	uses, so the navigation is written once. --}}
<dialog class="im-navpanel" id="{{#if id}}{{id}}{{else}}nav{{/if}}-panel" aria-label="{{t "Navigation"}}">
	<div class="im-navpanel-head">
		<a class="im-brand" href="{{@site.url}}">{{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}"><span>{{@site.title}}</span>{{else}}{{> "components/logo"}}{{/if}}</a>
		<button class="im-btn im-btn-ghost im-btn-icon" type="button" data-drawer-close aria-label="{{t "Close"}}">{{> "icons/x"}}</button>
	</div>

	<nav class="im-navpanel-cols" aria-label="{{t "Primary"}}">
		{{#if mega}}{{> (lookup . "mega")}}{{/if}}
		<div class="im-navcols">
			<div class="im-navcol im-navcol-compact">
				<p class="im-navcol-title">{{t "Site"}}</p>
				{{navigation as="items"}}
			</div>
			{{#if @site.secondary_navigation}}
			<div class="im-navcol im-navcol-compact">
				<p class="im-navcol-title">{{t "More"}}</p>
				{{navigation type="secondary" as="items"}}
			</div>
			{{/if}}
		</div>
	</nav>

	<div class="im-navpanel-foot">
		{{> "components/theme-switch" size="sm"}}
		{{#if github}}<a class="im-star im-star-sm" href="{{github}}" target="_blank" rel="noopener noreferrer"{{#if stars}} data-im-stars="{{stars}}"{{/if}}>{{> "icons/brand-github"}}<span>{{t "Star"}}</span><b data-im-star-count></b></a>{{/if}}
		<a class="im-btn im-btn-primary im-btn-sm" style="margin-left: auto" href="{{#if cta_url}}{{cta_url}}{{else}}#/portal/signup{{/if}}">{{#if cta_label}}{{cta_label}}{{else}}{{t "Subscribe"}}{{/if}}</a>
	</div>
</dialog>

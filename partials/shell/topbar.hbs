{{!-- Top bar (app layout — sits above a side nav).
	  start   nav toggle · brand · anything you put in the block
	  centre  search
	  end     search (phones) · theme toggle · GitHub star · your own partial
	Params: drawer (id of the phone menu panel), search_custom (true = do not
	wire Ghost's search), github (repo URL — shows a Star button), stars
	("owner/repo" — fills its count in from GitHub's public API), end (name of a
	partial to render at the far right). --}}
<header class="im-topbar">
	<div class="im-topbar-start">
		<button class="im-btn im-btn-ghost im-btn-icon max-lg:hidden" type="button" data-nav-toggle aria-label="{{t "Collapse navigation"}}" aria-expanded="true">{{> "icons/panel-left"}}</button>
		<button class="im-btn im-btn-ghost im-btn-icon md:hidden" type="button" data-drawer-open="#{{#if drawer}}{{drawer}}{{else}}drawer{{/if}}" aria-label="{{t "Open navigation"}}">{{> "icons/menu"}}</button>
		{{!-- The wordmark IS the name — a logo the visitor can read. A theme
		      that uploads its own picture gets the picture and the name beside
		      it, as Ghost's own settings expect. --}}
		<a class="im-brand" href="{{@site.url}}">
			{{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}"><span>{{@site.title}}</span>{{else}}{{> "components/logo"}}{{/if}}
		</a>
		{{#if @partial-block}}{{> @partial-block}}{{/if}}
	</div>

	<div class="im-topbar-search">
		<button class="im-searchbar" type="button" data-search-open{{#unless search_custom}} data-ghost-search{{/unless}}>
			{{> "icons/search"}}<span>{{t "Search"}}</span><kbd>/</kbd>
		</button>
	</div>

	<div class="im-topbar-end">
		<button class="im-btn im-btn-ghost im-btn-icon md:hidden" type="button" data-search-open{{#unless search_custom}} data-ghost-search{{/unless}} aria-label="{{t "Search"}}">{{> "icons/search"}}</button>
		{{> "components/theme-button"}}
		{{#if github}}
			<a class="im-star im-star-sm max-sm:hidden" href="{{github}}" target="_blank" rel="noopener noreferrer"{{#if stars}} data-im-stars="{{stars}}"{{/if}}>{{> "icons/brand-github"}}<span>{{t "Star"}}</span><b data-im-star-count>{{#if star_count}}{{star_count}}{{/if}}</b></a>
			<a class="im-btn im-btn-ghost im-btn-icon sm:hidden" href="{{github}}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">{{> "icons/brand-github"}}</a>
		{{/if}}
		{{#if end}}{{> (lookup . "end")}}{{/if}}
	</div>
</header>

{{!-- Snippet card — the file's name, then the code, on a light ground. No
	editor chrome and no copy button: a grid card is for deciding whether to
	open the snippet, and the single page has the dark editor and the copy. --}}
<article class="im-snipcard{{#if class}} {{class}}{{/if}}"{{#if langColor}} style="--im-repo-lang: {{langColor}}"{{/if}}>
	<h2 class="im-snipcard-title"><a href="{{#if url}}{{url}}{{else}}/collections/snippets/page/{{/if}}">{{name}}</a></h2>
	<p class="im-snipcard-text">{{text}}</p>
	<figure class="im-editor im-editor-plain">
		<p class="im-editor-head">{{> "icons/file-code"}}{{file}}<small>{{lang}}</small></p>
		<div class="im-editor-body">
			<pre class="im-editor-lines" aria-hidden="true">{{lines}}</pre>
			<pre><code class="language-{{lang_class}}">{{snippet}}</code></pre>
		</div>
	</figure>
	<p class="im-snipcard-meta"><span class="im-kind" data-kind="snippet">{{> "icons/code"}}Snippet</span><span>{{file}}</span></p>
</article>

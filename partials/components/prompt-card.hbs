{{!-- Prompt card — an abstraction: the name, what it is for, the first line
	of the prompt as a teaser. The prompt itself and the conversation are on
	the single page. --}}
<article class="im-promptcard{{#if class}} {{class}}{{/if}}">
	<p><span class="im-kind" data-kind="prompt">{{> "icons/sparkles"}}Prompt</span></p>
	<h2 class="im-promptcard-title"><a href="{{#if url}}{{url}}{{else}}/collections/prompts/page/{{/if}}">{{name}}</a></h2>
	<p class="im-promptcard-text">{{text}}</p>
	<p class="im-promptcard-teaser">“{{excerpt_line}}…”</p>
	<p class="im-snipcard-meta"><span>{{model}}</span><span>{{tokens}}</span></p>
</article>

{{!-- Prompt card — a small chat window. The log carries the line about the
	prompt; the title sits in the composer as if being typed. The prompt
	itself is on the single page. --}}
<article class="im-promptcard{{#if class}} {{class}}{{/if}}">
	<div class="im-chat">
		<p class="im-chat-model">{{> "icons/sparkles"}}{{model}}<span class="im-chat-model-push">{{tokens}}</span></p>
		<div class="im-chat-log"><p class="im-chat-empty">{{text}}</p></div>
		<p class="im-chat-input"><span class="im-chat-caret">{{name}}</span><a class="im-btn im-btn-sm im-btn-icon im-btn-primary" href="{{#if url}}{{url}}{{else}}/collections/prompts/page/{{/if}}" aria-label="Open {{name}}">{{> "icons/arrow-up"}}</a></p>
	</div>
	<h2 class="im-promptcard-title"><a href="{{#if url}}{{url}}{{else}}/collections/prompts/page/{{/if}}">{{name}}</a></h2>
</article>

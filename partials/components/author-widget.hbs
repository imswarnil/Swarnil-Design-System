{{!-- The author as a stacked card. Context: an author. Params: title, cta. --}}
<section class="im-widget im-widget-person" aria-label="{{#if title}}{{title}}{{else}}{{t "Written by"}}{{/if}}">
	{{> "components/avatar" size="xl" src=profile_image name=name}}
	<p class="im-widget-author-name">{{name}}</p>
	<p class="im-widget-author-role">{{#if location}}{{location}}{{else}}Amsterdam{{/if}} · Salesforce consultant · design systems</p>
	<p class="im-widget-sponsor">{{#if bio}}{{bio}}{{else}}Writes down what things cost. Built the system this site runs on.{{/if}}</p>
	<div class="im-widget-person-stats">
		<div>{{> "icons/pencil"}}<strong>34</strong><span>{{t "Posts"}}</span></div>
		<div>{{> "icons/users"}}<strong>4,210</strong><span>{{t "Readers"}}</span></div>
		<div>{{> "icons/brand-youtube"}}<strong>128k</strong><span>{{t "Subscribers"}}</span></div>
	</div>
	<p class="im-cluster" style="--im-cluster-gap: .375rem; margin-top: .875rem">
		<a class="im-btn im-btn-sm im-btn-icon" href="#" aria-label="GitHub">{{> "icons/brand-github"}}</a>
		<a class="im-btn im-btn-sm im-btn-icon" href="#" aria-label="LinkedIn">{{> "icons/brand-linkedin"}}</a>
		<a class="im-btn im-btn-sm im-btn-icon" href="#" aria-label="X">{{> "icons/brand-x"}}</a>
		<a class="im-btn im-btn-sm im-btn-primary" href="/pages/contact/">{{> "icons/mail"}}{{#if cta}}{{cta}}{{else}}{{t "Say hello"}}{{/if}}</a>
	</p>
</section>

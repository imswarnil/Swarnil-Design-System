{{!-- The author as a card that opens. Context: an author. Params: title, cta, open. --}}
<details class="im-widget im-widget-person"{{#if open}} open{{/if}}>
	<summary>
		{{> "components/avatar" size="xl" src=profile_image name=name}}
		<p class="im-widget-author-name">{{name}}</p>
		<p class="im-widget-author-role">Salesforce consultant · design systems</p>
		<span class="im-btn im-btn-sm im-widget-person-open">{{> "icons/chevron-down"}}{{t "About the author"}}</span>
		<span class="im-btn im-btn-sm im-widget-person-close">{{> "icons/chevron-up"}}{{t "Less"}}</span>
	</summary>
	<div class="im-widget-person-body">
		<p class="im-widget-sponsor">{{#if bio}}{{bio}}{{else}}Writes down what things cost. Built the design system this site runs on, and sells it.{{/if}}</p>
		<div class="im-widget-person-stats">
			<div>{{> "icons/pencil"}}<strong>34</strong><span>{{t "Posts"}}</span></div>
			<div>{{> "icons/users"}}<strong>4,210</strong><span>{{t "Readers"}}</span></div>
			<div>{{> "icons/map-pin"}}<strong>NL</strong><span>{{t "Amsterdam"}}</span></div>
		</div>
		<p class="im-cluster" style="--im-cluster-gap: .375rem">
			<a class="im-btn im-btn-sm im-btn-icon" href="#" aria-label="GitHub">{{> "icons/brand-github"}}</a>
			<a class="im-btn im-btn-sm im-btn-icon" href="#" aria-label="LinkedIn">{{> "icons/brand-linkedin"}}</a>
			<a class="im-btn im-btn-sm im-btn-icon" href="#" aria-label="YouTube">{{> "icons/brand-youtube"}}</a>
			<a class="im-btn im-btn-sm im-btn-primary" href="/pages/contact/">{{> "icons/mail"}}{{#if cta}}{{cta}}{{else}}{{t "Say hello"}}{{/if}}</a>
		</p>
	</div>
</details>

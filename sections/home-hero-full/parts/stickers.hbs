{{!-- The things stuck around the picture. Every one is optional and comes
	from a parameter, so a site that passes none gets the plain frame:

	  sticker_1 … sticker_4         four pills, one per corner, each with an
	  sticker_1_icon … _4_icon      icon name from partials/icons (optional)
	  hand                          a handwritten line with a drawn arrow
	                                pointing at the picture
	  stamp                         words that go round a turning stamp —
	                                "building in public · since 2018 · "
	  clock, clock_label            an IANA zone, and the words after the
	                                time: "Europe/Budapest", "in Budapest".
	                                hero.js keeps it ticking

	They are decoration with words on them, so each one is in the accessible
	tree as plain text; the arrow and the stamp's ring are hidden. On a phone
	the corners are off screen — the pills collapse to one row under the
	picture (hero.css §6b). --}}
{{#if sticker_1}}
<p class="im-hero__sticker" data-at="tl">{{#if sticker_1_icon}}{{#> (concat "icons/" sticker_1_icon)}}{{/undefined}}{{/if}}<span>{{sticker_1}}</span></p>
{{/if}}
{{#if sticker_2}}
<p class="im-hero__sticker" data-at="tr">{{#if sticker_2_icon}}{{#> (concat "icons/" sticker_2_icon)}}{{/undefined}}{{/if}}<span>{{sticker_2}}</span></p>
{{/if}}
{{#if sticker_3}}
<p class="im-hero__sticker" data-at="bl">{{#if sticker_3_icon}}{{#> (concat "icons/" sticker_3_icon)}}{{/undefined}}{{/if}}<span>{{sticker_3}}</span></p>
{{/if}}
{{#if sticker_4}}
<p class="im-hero__sticker" data-at="br">{{#if sticker_4_icon}}{{#> (concat "icons/" sticker_4_icon)}}{{/undefined}}{{/if}}<span>{{sticker_4}}</span></p>
{{/if}}
{{#if clock}}
<p class="im-hero__sticker im-hero__clock" data-at="clock"><span class="im-hero__clock-dot" aria-hidden="true"></span><time data-hero-clock="{{clock}}">--:--</time>{{#if clock_label}}<span>{{clock_label}}</span>{{/if}}</p>
{{/if}}
{{#if hand}}
<p class="im-hero__hand">
	<span class="im-hero__hand-text">{{hand}}</span>
	<svg class="im-hero__hand-arrow" viewBox="0 0 120 60" aria-hidden="true" focusable="false"><path d="M4 50 C 30 54, 70 50, 104 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" pathLength="1"/><path d="M90 12 L 106 11 L 101 26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/></svg>
</p>
{{/if}}
{{#if stamp}}
<p class="im-hero__stamp" aria-label="{{stamp}}">
	<svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
		<defs><path id="im-hero-stamp-ring" d="M50 50 m-36 0 a36 36 0 1 1 72 0 a36 36 0 1 1 -72 0"/></defs>
		<text class="im-hero__stamp-text"><textPath href="#im-hero-stamp-ring">{{stamp}} {{stamp}}</textPath></text>
		<circle cx="50" cy="50" r="23" class="im-hero__stamp-core"/>
		<circle cx="50" cy="50" r="5" class="im-hero__stamp-dot"/>
	</svg>
</p>
{{/if}}

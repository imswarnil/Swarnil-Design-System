{{!-- The wash, in layers: a CSS mesh (the still fallback), the mp4 loop lit
	through it, a drawn pattern over both when one is asked for, grain over
	everything, and a watermark word low in the corner. Decorative — no
	sound, no controls, hidden from assistive tech.

	  pattern     grid · dots · lines   drawn with gradients, faded to the
	                                     edges so it never meets the frame
	  watermark   one word, outlined, huge and faint, drifting --}}
<div class="im-hero__bg" aria-hidden="true">
	<div class="im-hero__mesh"></div>
	<div class="im-hero__plate">
		<video class="im-hero__loop" autoplay muted loop playsinline disablepictureinpicture preload="auto" poster="{{asset "sections/home-hero-full/media/hero-loop.jpg"}}" data-hero-loop>
			<source src="{{asset "sections/home-hero-full/media/hero-loop.mp4"}}" type="video/mp4">
		</video>
	</div>
	{{#if pattern}}<div class="im-hero__pattern" data-pattern="{{pattern}}"></div>{{/if}}
	<div class="im-hero__noise"></div>
	{{#if watermark}}<span class="im-hero__watermark">{{watermark}}</span>{{/if}}
</div>

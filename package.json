{
  "name": "@imswarnil/swarnil-design",
  "version": "0.1.0",
  "description": "Swarnil Design System \u2014 a token-first, dependency-free CSS design system. Almost monochrome, so one colour can mean something.",
  "keywords": [
    "css",
    "design-system",
    "ui-kit",
    "tokens",
    "design-tokens",
    "component-library",
    "oklch",
    "dark-mode"
  ],
  "homepage": "https://design.imswarnil.com",
  "bugs": "https://github.com/imswarnil/swarnil-design/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imswarnil/swarnil-design.git"
  },
  "author": {
    "name": "Swarnil Singhai",
    "url": "https://imswarnil.com"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "style": "dist/swarnil-design.css",
  "main": "dist/swarnil-design.css",
  "exports": {
    ".": "./dist/swarnil-design.css",
    "./css": "./dist/swarnil-design.css",
    "./min": "./dist/swarnil-design.min.css",
    "./config": "./src/0-config/index.css",
    "./foundation": "./src/1-foundation/index.css",
    "./elements": "./src/2-elements/index.css",
    "./components": "./src/3-components/index.css",
    "./utilities": "./src/6-utilities/index.css",
    "./src/*": "./src/*",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:min && npm run docs",
    "build:css": "postcss src/index.css -o dist/swarnil-design.css",
    "build:min": "postcss src/index.css -o dist/swarnil-design.min.css --env production",
    "docs": "python3 docs/build.py",
    "dev": "npm run docs && python3 -m http.server 8080 --directory site",
    "lint": "stylelint \"src/**/*.css\"",
    "audit": "npm run audit:mono && npm run audit:classes",
    "audit:mono": "python3 scripts/audit-mono.py --strict",
    "audit:classes": "python3 scripts/audit-classes.py",
    "size": "gzip -c dist/swarnil-design.min.css | wc -c | awk '{printf \"gzipped: %.1f KB\\n\", $1/1024}'",
    "prepublishOnly": "npm run build:css && npm run build:min"
  },
  "devDependencies": {
    "cssnano": "^7.0.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/imswarnil"
    }
  ]
}
